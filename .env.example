# Local Vite reads Frontend/.env  (npm run dev)
# Production builds read Frontend/.env.production and netlify.toml [build.environment]
# Netlify UI env vars also work, then Redeploy with cache clear.
# Do not commit Frontend/.env — it is gitignored.

# Local: http://localhost:5000
# Production: leave empty so the shop uses same-origin /api (Netlify proxy)
VITE_BACKEND_URL=
VITE_UPLOAD_BACKEND_URL=https://api.monorom.store
