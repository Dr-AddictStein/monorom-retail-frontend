# Used by `vite build` (Netlify production). Local `vite` / `npm run dev` still reads .env
# Empty = same-origin `/api` (Netlify proxies to Vercel). Do not point at api.deliymug.com
# from the browser — privacy extensions often block `api.*` hosts.
VITE_BACKEND_URL=
VITE_UPLOAD_BACKEND_URL=https://api.monorom.store
